{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "include": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemKind"
      }
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "shed": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemKind"
          }
        },
        "path": {
          "type": "string"
        },
        "shed": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ItemKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Item"
        }
      ]
    }
  }
}
