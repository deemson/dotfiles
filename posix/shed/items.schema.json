{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_ItemEntry",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ItemEntry"
  },
  "$defs": {
    "ItemEntry": {
      "type": "object",
      "properties": {
        "shed": {
          "description": "Relative path within the item's storage directory",
          "type": "string"
        },
        "system": {
          "description": "Absolute system path (supports $HOME expansion)",
          "type": "string"
        }
      },
      "required": [
        "system",
        "shed"
      ]
    }
  }
}
